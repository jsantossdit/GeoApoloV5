        object memodescricao: TMemo
          Left = 8
          Top = 24
          Width = 277
          Height = 225
          Lines.Strings = (
            'SISTEMA GERENCIADOR AUXILIAR DO APOLO - '
            'RIOSOFT'
            'Desenvolvido para disponibilizar ao usu'#225'rios algumas '
            'funcionalidades cujo '
            'Apolo n'#227'o contempla, tamb'#233'm um meio r'#225'pido de '
            'extra'#231#227'o de dados atrav'#233's'
            'de consultas imediatas, trata-se de c'#243'digos SQL '
            'desenvolvidos pelo suporte'
            ' de TI que '#233' executado direto na base do apolo.'
            ''
            'Desenvolvido por SDIT - Decis'#245'es Inteligentes em TI'
            'Analista J'#250'lio C'#233'sar dos Santos'
            '(12) 99738-3377'
            'julio.santos@sdit.com.br')
