    object Memo1: TMemo
      Left = 8
      Top = 48
      Width = 521
      Height = 269
      Font.Charset = ANSI_CHARSET
      Font.Color = clNavy
      Font.Height = -15
      Font.Name = 'Times New Roman'
      Font.Style = []
      Lines.Strings = (
        
          'Esta op'#231#227'o funcionar'#225' corretamente para excluir lan'#231'amentos cont' +
          #225'beis que '
        
          'n'#227'o possuem origem nos demais m'#243'dulos do sistema, por isso verif' +
          'ique antes '
        
          'de excluir se o lan'#231'amento em quest'#227'o n'#227'o possui realmente sua o' +
          'rigem em '
        
          'algum m'#243'dulo do Apolo, pois se existir, ao executar a op'#231#227'o Refa' +
          'zer '
        
          'Lan'#231'amentos Cont'#225'beis do m'#243'dulo cont'#225'bil,  o lan'#231'amento ser'#225' int' +
          'egrado '
        'novamente.'
        ''
        
          'Somente funcionar'#225' esta op'#231#227'o para excluir lan'#231'amentos que n'#227'o t' +
          'enham '
        'origem em algum m'#243'dulo do apolo.'
        ''
        'Para Lan'#231'amentos que tenham origem em algum m'#243'dulo do Apolo, '
        
          'recomenda-se a corre'#231#227'o do mesmo direto na sua Origem assim proc' +
          'edendo'
        'novamente a integra'#231#227'o deste movimento.'
        ''
        'Qualquer d'#250'vida entre em contato com o Depto. de T.I.')
      ParentFont = False
      TabOrder = 0
    end
